<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <add name="DBConnection" 
             connectionString="Server=.\SQLEXPRESS;Initial Catalog=entradas_tecnologico;Integrated Security=True;MultipleActiveResultSets=False;Connection Timeout=10;"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
    <!-- SEGURIDAD: Este archivo contiene credenciales sensibles.
         NO subir al repositorio. Está incluido en .gitignore.
         Usa App.config.template como referencia para configurar este archivo. -->
    <appSettings>
        <!-- IP del servidor (solo para Modo = "red") -->
        <add key="IPServidor" value="10.88.87.231"/>
        <!-- Contraseña del usuario 'sa' en SQL Server (solo para Modo = "red") -->
        <add key="PasswordRed" value="TecnoLocal2026"/>
        <!-- Contraseña del usuario de Google Cloud SQL (solo para Modo = "nube") -->
        <add key="PasswordNube" value="Tecno.GCP.2026"/>
    </appSettings>
</configuration>
